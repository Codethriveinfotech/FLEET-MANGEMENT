datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DRIVER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum LogStatus {
  ACTIVE
  COMPLETED
}

enum MaintenanceStatus {
  REPORTED
  IN_PROGRESS
  RESOLVED
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             Role             @default(DRIVER)
  phoneNumber      String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  refreshTokens    RefreshToken[]
  driverLogs       DriverLog[]
  fuelLogs         FuelLog[]
  maintenanceReports MaintenanceLog[] @relation("ReportedByUser")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Vehicle {
  id             String           @id @default(uuid())
  plateNumber    String           @unique
  make           String
  model          String
  year           Int
  status         VehicleStatus    @default(ACTIVE)
  fuelType       FuelType         @default(DIESEL)
  currentMileage Float            @default(0.0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  driverLogs     DriverLog[]
  fuelLogs       FuelLog[]
  maintenanceLogs MaintenanceLog[]

  @@map("vehicles")
}

model DriverLog {
  id           String    @id @default(uuid())
  driverId     String
  driver       User      @relation(fields: [driverId], references: [id])
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  startTime    DateTime  @default(now())
  endTime      DateTime?
  startMileage Float
  endMileage   Float?
  status       LogStatus @default(ACTIVE)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("driver_logs")
}

model FuelLog {
  id              String   @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId        String
  driver          User     @relation(fields: [driverId], references: [id])
  date            DateTime @default(now())
  gallonsOrLiters Float
  cost            Float
  odometerReading Float
  receiptUrl      String?
  createdAt       DateTime @default(now())

  @@map("fuel_logs")
}

model MaintenanceLog {
  id            String            @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  reportedById  String
  reportedBy    User              @relation("ReportedByUser", fields: [reportedById], references: [id])
  description   String            @db.Text
  status        MaintenanceStatus @default(REPORTED)
  cost          Float?
  scheduledDate DateTime?
  completedDate DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("maintenance_logs")
}
