# API Base Configuration (use machine IP instead of localhost for physical device debug)
EXPO_PUBLIC_API_URL="http://192.168.1.100:5000/api/v1"

# Google Maps SDK Keys
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS="your-ios-google-maps-key"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID="your-android-google-maps-key"

# Environment Mode
EXPO_PUBLIC_ENV="development"
