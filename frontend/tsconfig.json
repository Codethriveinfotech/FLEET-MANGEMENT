{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "typeRoots": [
      "../node_modules/@types",
      "./node_modules/@types"
    ],
    "paths": {
      "react": ["../node_modules/react"],
      "react-native": ["../node_modules/react-native"],
      "*": ["../node_modules/*", "./node_modules/*"]
    }
  }
}
